<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central Package Management refuses to restore with more than one
    unmapped package source (NU1507) unless sources are mapped, and this
    machine has an extra GitHub Packages feed configured globally for other
    work. This repo only needs nuget.org, so scope it to that alone rather
    than touching the user's global NuGet.Config.
  -->
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
