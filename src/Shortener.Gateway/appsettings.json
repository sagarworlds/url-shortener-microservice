{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "links-write": {
        "ClusterId": "links",
        "Order": 1,
        "Match": {
          "Path": "/api/links/{**remainder}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "links-read": {
        "ClusterId": "links",
        "Order": 1,
        "Match": {
          "Path": "/api/links/{**remainder}",
          "Methods": [ "GET", "DELETE" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "analytics": {
        "ClusterId": "analytics",
        "Order": 1,
        "Match": {
          "Path": "/api/analytics/{**remainder}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "redirect": {
        "ClusterId": "redirect",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "links": {
        "Destinations": {
          "links": {
            "Address": "https+http://links"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "analytics": {
            "Address": "https+http://analytics"
          }
        }
      },
      "redirect": {
        "Destinations": {
          "redirect": {
            "Address": "https+http://redirect"
          }
        }
      }
    }
  }
}
